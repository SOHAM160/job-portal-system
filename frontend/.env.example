# Frontend Environment Variables — copy this file to .env and fill in real values

# Required in production (Vercel): full URL of your Render backend
# Example: https://hirehub-api.onrender.com
VITE_API_URL=

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Socket.IO URL — usually the same as VITE_API_URL
# If omitted, VITE_API_URL is used automatically
VITE_SOCKET_URL=
